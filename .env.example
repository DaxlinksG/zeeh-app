PORT=3000

# GTP Sandbox credentials
GTP_BASE_URL=https://gtp-service-sandbox-1022294938286.northamerica-northeast1.run.app/gtp/v1
GTP_API_KEY=your_gtp_api_key_here

# Your own service API key (clients must send this)
SERVICE_API_KEY=your_service_api_key_here

# Default spread fallback (%) applied when no corridor-specific rate is set
DEFAULT_SPREAD_PCT=2.0

# Zeeh Africa API (identity + credit bureau — same key used for KYC)
ZEEH_KYC_SECRET_KEY=sk_live_...

# Credit report BVN encryption key — 32 random bytes as hex (64 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDIT_ENCRYPTION_KEY=

# Zeeh KYC service (kyc.zeehfi.ca)
KYC_SERVICE_URL=https://kyc.zeehfi.ca
KYC_API_KEY=kyc_live_...
KYC_WEBHOOK_SECRET=whsec_...

# ── Flutterwave ──────────────────────────────────────────────────────────────
# Switch between test and live: change FLW_ENV + swap FLW_CLIENT_ID / FLW_CLIENT_SECRET
# in Secrets Manager. That's the only change needed to go live.
FLW_ENV=test                          # 'test' | 'live'
FLW_CLIENT_ID=your_flw_client_id      # test: b4ec231b-... / live: ba4f96f1-...
FLW_CLIENT_SECRET=your_flw_secret     # test: t9DpI...    / live: vp8rt...
FLW_ENCRYPTION_KEY=your_flw_enc_key   # test: YoR5T...    / live: DJ54A...

# Currency your Flutterwave wallet is funded in (Flutterwave converts to destination)
FLW_SOURCE_CURRENCY=USD

# Webhook secret hash — set this in the Flutterwave dashboard → Webhooks
FLW_WEBHOOK_HASH=your_flw_webhook_hash

# Override base URLs (defaults are set in flutterwaveClient.ts)
# FLW_SANDBOX_BASE_URL=https://developersandbox-api.flutterwave.com
# FLW_BASE_URL=https://api.flutterwave.com

# Sender name shown on FLW payouts
FLW_SENDER_NAME_FIRST=Zeeh
FLW_SENDER_NAME_LAST=Finance
